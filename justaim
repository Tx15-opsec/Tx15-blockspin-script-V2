local function createToggle(parent, text, initial, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 40)
    btn.BackgroundColor3 = initial and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(35, 35, 50)
    btn.Text = text .. ": " .. (initial and "ON" or "OFF")
    btn.TextColor3 = initial and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 180)
    btn.TextSize = 13
    btn.Font = Enum.Font.FredokaOne
    btn.BorderSizePixel = 0
    btn.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    local state = initial
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(35, 35, 50)
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        btn.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 180)
        callback(state)
        saveConfig(Config.CurrentProfile)
    end)

    if text:find("Aimbot Active") then
        aimbotToggleBtn = btn
    end
end

