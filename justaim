    if readfile and isfile and isfile(BootConfigPath) then
        local bootData = game:GetService("HttpService"):JSONDecode(readfile(BootConfigPath))
        if bootData and bootData.DefaultProfile then
            loadConfig(bootData.DefaultProfile)
        end
    end
end)

