-- Integrated Name + Health Bar + Inventory ESP Logic
local function updateESP(p)
    local bb = BillboardCache[p]
    if not bb then return end
    
    local char = p.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not Config.ESPEnabled then 
        bb.Enabled = false
        return 
    end
    
    local lChar = LocalPlayer.Character
    if lChar and lChar:FindFirstChild("HumanoidRootPart") then
        local dist = (lChar.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
        if dist > MAX_DISTANCE then
            bb.Enabled = false
            return
        end
    end

    local container = bb:FindFirstChild("EspContainer")
    if not container then return end
    container:ClearAllChildren()

    local layout = Instance.new("UIListLayout", container)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom 
    layout.Padding = UDim.new(0, 2)

    -- Player Name & Health Bar Display
    local nameLbl = Instance.new("TextLabel", container)
    nameLbl.Size = UDim2.new(0, 200, 0, 16)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = p.DisplayName ~= p.Name and (p.DisplayName .. " (@" .. p.Name .. ")") or p.Name
    nameLbl.Font = Enum.Font.FredokaOne
    nameLbl.TextSize = 11
    nameLbl.TextColor3 = Color3.fromRGB(0, 255, 200)
    nameLbl.TextStrokeTransparency = 0.2

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local hpBg = Instance.new("Frame", container)
        hpBg.Size = UDim2.new(0, 120, 0, 5)
        hpBg.BackgroundColor3 = Color3.new(0, 0, 0)
        Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 3)

        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local hpFill = Instance.new("Frame", hpBg)
        hpFill.Size = UDim2.new(ratio, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
        Instance.new("UICorner", hpFill).CornerRadius = UDim.new(0, 3)
    end

    -- Inventory Tools Display
    if Config.ESPInventoryEnabled then
        local tools = {}
        if p:FindFirstChild("Backpack") then
            for _, t in ipairs(p.Backpack:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower() ~= "fists" then table.insert(tools, t) end
            end
        end
        if char then
            for _, t in ipairs(char:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower() ~= "fists" then table.insert(tools, t) end
            end
        end

        for _, tool in ipairs(tools) do
            local name = getRealName(tool)
            if name then
                local lbl = Instance.new("TextLabel", container)
                lbl.Size = UDim2.new(0, 180, 0, 14)
                lbl.BackgroundTransparency = 1
                lbl.Text = "🎒 " .. name
                lbl.Font = Enum.Font.SourceSansBold
                lbl.TextSize = 10
                lbl.TextStrokeTransparency = 0.4
                
                local rarity = tool:GetAttribute("RarityName") or tool:GetAttribute("Rarity")
                lbl.TextColor3 = RARITY_COLORS[rarity] or Color3.new(1, 1, 1)
            end
        end
    end

    bb.Enabled = Config.ESPEnabled
end

local function createESP(p)
    if p == LocalPlayer then return end
    
    local function setup(char)
        local root = char:WaitForChild("HumanoidRootPart", 15)
        if not root then return end
        
        if BillboardCache[p] then BillboardCache[p]:Destroy() end
        
        local bb = Instance.new("BillboardGui", root)
        bb.Name = "FixedUnderfootESP"
        bb.Size = UDim2.new(0, 200, 0, 160)
        bb.StudsOffset = Vector3.new(0, -3.5, 0) 
        bb.AlwaysOnTop = true
        bb.MaxDistance = MAX_DISTANCE
        
        local cont = Instance.new("Frame", bb)
        cont.Name = "EspContainer"
        cont.Size = UDim2.new(1, 0, 1, 0)
        cont.BackgroundTransparency = 1
        
        BillboardCache[p] = bb

        updateESP(p)
        
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1); updateESP(p) end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1); updateESP(p) end
        end)
        
        local backpack = p:WaitForChild("Backpack", 5)
        if backpack then
            backpack.ChildAdded:Connect(function() updateESP(p) end)
            backpack.ChildRemoved:Connect(function() updateESP(p) end)
        end

        task.spawn(function()
            while char.Parent and bb.Parent do
                updateESP(p)
                task.wait(UPDATE_INTERVAL)
            end
        end)
    end
    
    p.CharacterAdded:Connect(setup)
    if p.Character then setup(p.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)

-- Streamlined On-Foot Target Acquisition
local function GetTargetPart(char)
    local mode = AIM_MODES[Config.AimPartMode]
    local partName = mode.parts and mode.parts[currentAutoIndex] or mode.part
    
    local part = char:FindFirstChild(partName)
    if not part then
        if partName == "RightUpperArm" then part = char:FindFirstChild("Right Arm") end
        if partName == "LeftUpperArm"   then part = char:FindFirstChild("Left Arm") end
    end
    return part or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character or workspace, part.Parent}
    local result = workspace:Raycast(origin, direction, params)
    return not result
end

local function GetClosestTarget()
    local closest, distMin = nil, Config.FOVRadius
    local center = Vector2.new(Camera.ViewportSize.X / 2, (Camera.ViewportSize.Y / 2) + Config.FOVOffsetY)
    
    for _, p in Players:GetPlayers() do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if humanoid and humanoid.Health > 0 then
                local candidatePart = GetTargetPart(char)
                
                if candidatePart then
                    local calcPos = candidatePart.Position
                    
                    -- Simple On-Foot Velocity Lead Prediction
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        calcPos = calcPos + (root.AssemblyLinearVelocity * PREDICTION_TIME)
                    end
                    
                    local screenPos, onScreen = Camera:WorldToViewportPoint(calcPos)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < distMin then
                            if not Config.WallCheck or IsVisible(candidatePart) then
                                distMin = dist
                                closest = calcPos
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- RenderStepped Main Tracking Loop
RunService.RenderStepped:Connect(function()
    pcall(function()
        FOVFrame.Position = UDim2.new(0.5, 0, 0.5, Config.FOVOffsetY)

        if Config.AimbotActive then
            local targetPos = GetClosestTarget()
            if targetPos then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                
                if Config.AimStrength >= 1.0 then
                    Camera.CFrame = targetCFrame
                else
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.AimStrength)
                end
            end
        end
    end)
end)

-- Auto Switch Heartbeat Timer
RunService.Heartbeat:Connect(function(dt)
    local mode = AIM_MODES[Config.AimPartMode]
    if not mode.parts then return end
    lastSwitchTime = lastSwitchTime + dt
    if lastSwitchTime >= SWITCH_INTERVAL then
        lastSwitchTime = 0
        currentAutoIndex = currentAutoIndex % #mode.parts + 1
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    pcall(function()
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local aimKeyEnum = typeof(Config.AimKey) == "EnumItem" and Config.AimKey or Enum.KeyCode[tostring(Config.AimKey)] or Enum.KeyCode.E
            local menuKeyEnum = typeof(Config.MenuKey) == "EnumItem" and Config.MenuKey or Enum.KeyCode[tostring(Config.MenuKey)] or Enum.KeyCode.Insert

            if input.KeyCode == aimKeyEnum then
                Config.AimbotActive = not Config.AimbotActive
                if aimbotToggleBtn then
                    aimbotToggleBtn.BackgroundColor3 = Config.AimbotActive and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(35, 35, 50)
                    aimbotToggleBtn.Text = "🎯 Aimbot Active: " .. (Config.AimbotActive and "ON" or "OFF")
                    aimbotToggleBtn.TextColor3 = Config.AimbotActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 180)
                end
            elseif input.KeyCode == menuKeyEnum then
                MainFrame.Visible = not MainFrame.Visible
            end
        end
    end)
end)
